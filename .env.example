# VLC Streaming Server Environment Configuration
# Copy this file to .env and customize as needed for Docker Compose

# Server Configuration
PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,docker.local

# YouTube Integration (required for /playlist endpoint)
# Get your API key from: https://console.cloud.google.com/
# Enable the YouTube Data API v3 for your project
YOUTUBE_API_KEY=your_youtube_api_key_here

# Named Playlists (optional - accessible via /playlist/name)
# Use any name after PLAYLIST_ - it becomes the endpoint path
# Examples:
#   PLAYLIST_FAVORITES -> accessible at /playlist/favorites
#   PLAYLIST_ROCK -> accessible at /playlist/rock
#   PLAYLIST_STUDY_MUSIC -> accessible at /playlist/study_music
#
# Values can be playlist IDs or full YouTube URLs
#PLAYLIST_FAVORITES=PL6NdkXsPL07Il2hEQGcLI4dg_LTg7xA2L
#PLAYLIST_ROCK=PLrCZV99gFgI_fAd8XJ14-3LxpJ3L_Klwg
#PLAYLIST_CHILL=your_chill_playlist_id_here
#PLAYLIST_WORKOUT=your_workout_playlist_id_here
#PLAYLIST_STUDY_MUSIC=your_study_playlist_id_here
#PLAYLIST_CLASSICAL=your_classical_playlist_id_here
#PLAYLIST_JAZZ=your_jazz_playlist_id_here

# Performance Tuning
PUMA_THREADS=10
WEB_CONCURRENCY=0

# Streaming Configuration
# Chunk size for reading data from VLC (bytes)
STREAM_CHUNK_SIZE=8192
# Timeout for I/O select operations (seconds)
STREAM_SELECT_TIMEOUT=0.1

# VLC Process Management
# Timeout for graceful VLC shutdown (seconds)
VLC_GRACEFUL_TIMEOUT=5
# Timeout for forced VLC shutdown (seconds)
VLC_FORCE_TIMEOUT=2

# Rack Environment
RACK_ENV=production

# Example configurations for different scenarios:

# Development
#PORT=3000
#ALLOWED_HOSTS=localhost,127.0.0.1,dev.myapp.com
#PUMA_THREADS=5
#WEB_CONCURRENCY=1
#RACK_ENV=development
#YOUTUBE_API_KEY=your_dev_api_key_here

# Production
#PORT=80
#ALLOWED_HOSTS=myapp.com,www.myapp.com,streaming.myapp.com
#PUMA_THREADS=15
#WEB_CONCURRENCY=2
#RACK_ENV=production
#YOUTUBE_API_KEY=your_prod_api_key_here

# Testing
#PORT=9999
#ALLOWED_HOSTS=test.localhost,127.0.0.1
#PUMA_THREADS=3
#WEB_CONCURRENCY=0
#RACK_ENV=test
#YOUTUBE_API_KEY=your_test_api_key_here
