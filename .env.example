# VLC Streaming Server Environment Configuration
# Copy this file to .env and customize as needed for Docker Compose

# Server Configuration
HTTP_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,docker.local

# Rack Environment
RACK_ENV=production

# Example configurations for different scenarios:

# Development
#HTTP_PORT=3000
#ALLOWED_HOSTS=localhost,127.0.0.1,dev.myapp.com
#RACK_ENV=development

# Production
#HTTP_PORT=80
#ALLOWED_HOSTS=myapp.com,www.myapp.com,streaming.myapp.com
#RACK_ENV=production

# Testing
#HTTP_PORT=9999
#ALLOWED_HOSTS=test.localhost,127.0.0.1
#RACK_ENV=test
